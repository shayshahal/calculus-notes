		{"id":"title","type":"text","text":"# Continuity - רציפות\n\n**רציפות במידה שווה = שאלת בונוס (7 נק')!**","x":-50,"y":-550,"width":450,"height":100,"color":"2"},
		{"id":"def-cont","type":"file","file":"Definitions/Def - רציפות נקודתית.md","x":-470,"y":-360,"width":320,"height":60},
		{"id":"def-cont-interval","type":"file","file":"Definitions/Def - רציפות בקטע.md","x":-470,"y":-290,"width":320,"height":60},
