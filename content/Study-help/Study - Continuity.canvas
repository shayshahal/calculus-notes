{
	"nodes":[
		{"id":"group-uniform","type":"group","x":-70,"y":-400,"width":450,"height":1060,"color":"1","label":"UNIFORM CONTINUITY - רציפות במ\"ש (בונוס!)"},
		{"id":"group-theorems","type":"group","x":440,"y":-400,"width":360,"height":940,"color":"2","label":"KEY THEOREMS - משפטים מרכזיים"},
